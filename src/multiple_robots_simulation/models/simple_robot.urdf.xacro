<?xml version="1.0"?>
<!-- =================================================================================== -->
<!-- | Reference from https://bitbucket.org/theconstructcore/box_bot/src/foxy/box_bot_description/robot/box_bot_v2.urdf | -->
<!-- =================================================================================== -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="simple_robot">

  <xacro:arg name="robot_name" default="robot"/>
  <xacro:arg name="robot_color" default="Blue"/>

  <!-- Robot properties -->
  <xacro:property name="robot_radius" value="0.1"/>
  <xacro:property name="robot_length" value="0.3"/>
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_thickness" value="0.04"/>
  <xacro:property name="wheel_separation" value="0.2"/>
  <xacro:property name="mass_chassis" value="1.0"/>
  <xacro:property name="mass_wheel" value="0.2"/>

  <!-- Colors -->
  <material name="Blue">
    <color rgba="0 0 0.8 1"/>
  </material>
  <material name="Red">
    <color rgba="0.8 0 0 1"/>
  </material>
  <material name="Green">
    <color rgba="0 0.8 0 1"/>
  </material>
  <material name="Yellow">
    <color rgba="0.8 0.8 0 1"/>
  </material>
  <material name="Black">
    <color rgba="0 0 0 1"/>
  </material>

  <!-- Base Link -->
  <link name="$(arg robot_name)/base_link">
    <visual>
      <geometry>
        <cylinder length="${robot_length}" radius="${robot_radius}"/>
      </geometry>
      <material name="$(arg robot_color)"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="${robot_length}" radius="${robot_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${mass_chassis}"/>
      <inertia ixx="${mass_chassis * (3 * robot_radius * robot_radius + robot_length * robot_length) / 12}" 
               ixy="0.0" ixz="0.0" 
               iyy="${mass_chassis * (3 * robot_radius * robot_radius + robot_length * robot_length) / 12}" 
               iyz="0.0" 
               izz="${mass_chassis * robot_radius * robot_radius / 2}"/>
    </inertial>
  </link>

  <!-- Left Wheel Link -->
  <link name="$(arg robot_name)/wheel_left_link">
    <visual>
      <geometry>
        <cylinder length="${wheel_thickness}" radius="${wheel_radius}"/>
      </geometry>
      <material name="Black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="${wheel_thickness}" radius="${wheel_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${mass_wheel}"/>
      <inertia ixx="${mass_wheel * (3 * wheel_radius * wheel_radius + wheel_thickness * wheel_thickness) / 12}" 
               ixy="0.0" ixz="0.0" 
               iyy="${mass_wheel * (3 * wheel_radius * wheel_radius + wheel_thickness * wheel_thickness) / 12}" 
               iyz="0.0" 
               izz="${mass_wheel * wheel_radius * wheel_radius / 2}"/>
    </inertial>
  </link>

  <!-- Right Wheel Link -->
  <link name="$(arg robot_name)/wheel_right_link">
    <visual>
      <geometry>
        <cylinder length="${wheel_thickness}" radius="${wheel_radius}"/>
      </geometry>
      <material name="Black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="${wheel_thickness}" radius="${wheel_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${mass_wheel}"/>
      <inertia ixx="${mass_wheel * (3 * wheel_radius * wheel_radius + wheel_thickness * wheel_thickness) / 12}" 
               ixy="0.0" ixz="0.0" 
               iyy="${mass_wheel * (3 * wheel_radius * wheel_radius + wheel_thickness * wheel_thickness) / 12}" 
               iyz="0.0" 
               izz="${mass_wheel * wheel_radius * wheel_radius / 2}"/>
    </inertial>
  </link>

  <!-- Left Wheel Joint -->
  <joint name="$(arg robot_name)/wheel_left_joint" type="continuous">
    <parent link="$(arg robot_name)/base_link"/>
    <child link="$(arg robot_name)/wheel_left_link"/>
    <origin xyz="0 ${wheel_separation/2} 0" rpy="${-pi/2} 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Right Wheel Joint -->
  <joint name="$(arg robot_name)/wheel_right_joint" type="continuous">
    <parent link="$(arg robot_name)/base_link"/>
    <child link="$(arg robot_name)/wheel_right_link"/>
    <origin xyz="0 ${-wheel_separation/2} 0" rpy="${-pi/2} 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Gazebo plugins -->
  <gazebo>
    <plugin name="$(arg robot_name)_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <update_rate>30</update_rate>
      <left_joint>$(arg robot_name)/wheel_left_joint</left_joint>
      <right_joint>$(arg robot_name)/wheel_right_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_diameter>${2*wheel_radius}</wheel_diameter>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <max_wheel_torque>20</max_wheel_torque>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_frame>$(arg robot_name)/odom</odometry_frame>
      <robot_base_frame>$(arg robot_name)/base_link</robot_base_frame>
      <odometry_topic>$(arg robot_name)/odom</odometry_topic>
      <cmd_vel_topic>$(arg robot_name)/cmd_vel</cmd_vel_topic>
    </plugin>
  </gazebo>

</robot>
